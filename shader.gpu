// Vertex Shader
const vertexShaderSource = `#version 300 es

in vec3 position;
in vec3 normal;
in vec3 tangent;
in vec2 texCoord;

uniform mat4 projMatrix;
uniform mat4 modelMat;
uniform mat4 normalMat;

uniform vec3 lightPos;

uniform sampler2D texDiffuse;
uniform sampler2D texNormal;
uniform sampler2D texSpecular;

uniform vec2 pivot;
uniform float rotation;

flat out vec3 finalColor;

vec2 rotateUV(vec2 uv, vec2 center, float angle) {
    uv -= center;
    float c = cos(angle);
    float s = sin(angle);
    uv = vec2(
        uv.x * c - uv.y * s,
        uv.x * s + uv.y * c
    );
    return uv + center;
}

vec3 computeWorldNormal(vec2 uvCoord) {
    vec3 baseNormal = normalize(mat3(normalMat) * normal);
    vec3 baseTangent = normalize(mat3(normalMat) * tangent);
    baseNormal = normalize(baseNormal - dot(baseTangent, baseNormal) * baseTangent);

    vec3 bitangent = cross(baseTangent, baseNormal);
    vec3 sampledNormal = texture(texNormal, uvCoord).rgb * 2.0 - 1.0;

    mat3 tbnMatrix = mat3(baseTangent, bitangent, baseNormal);
    return normalize(tbnMatrix * sampledNormal);
}

void main() {
    float ambientIntensity = 0.2;
    vec2 uv = rotateUV(texCoord, pivot, rotation);
    vec3 surfaceColor = texture(texDiffuse, uv).rgb;
    float specularPower = pow(texture(texSpecular, uv).r, 2.0);

    vec4 transformedVertex = modelMat * vec4(position, 1.0);
    vec3 worldPos = transformedVertex.xyz / transformedVertex.w;

    vec3 norm = computeWorldNormal(uv);
    vec3 lightDir = normalize(worldPos - lightPos);
    vec3 viewDir = normalize(-worldPos);

    if (dot(norm, viewDir) < 0.0) {
        norm = -norm;
    }

    vec3 ambient = surfaceColor * ambientIntensity;
    vec3 diffuse = max(dot(norm, -lightDir), 0.0) * surfaceColor * (1.0 - ambientIntensity);
    vec3 reflectDir = reflect(lightDir, norm);
    vec3 specular = vec3(specularPower) * pow(max(dot(viewDir, reflectDir), 0.0), 32.0);

    finalColor = ambient + diffuse + specular;
    gl_Position = projMatrix * transformedVertex;
}`;

// Fragment Shader
const fragmentShaderSource = `#version 300 es
precision highp float;

flat in vec3 finalColor;
out vec4 fragOutput;

void main() {
    fragOutput = vec4(finalColor, 1.0);
}`;
